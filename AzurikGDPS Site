.dashlink:hover{transform:translateY(-3px);border-color:#25e5ff;box-shadow:0 0 20px #00bfff22}
.dashlink b{display:block;margin-bottom:6px;color:#dff7ff}
.dashlink small{color:#a9c3e8}
.status-empty{color:#ffca75!important}
.dash-icon{font-size:22px;margin-right:7px}

