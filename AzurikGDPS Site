background-image:linear-gradient(#328aff 1px,transparent 1px),
linear-gradient(90deg,#328aff 1px,transparent 1px);
background-size:40px 40px
}
a{color:inherit;text-decoration:none}
button{font-family:inherit}
header{
position:sticky;top:0;z-index:20;
background:#04091ee8;backdrop-filter:blur(14px);
border-bottom:1px solid #168cff66
}
.nav{
max-width:1300px;margin:auto;padding:14px 20px;
display:flex;align-items:center;justify-content:space-between;gap:15px
}
.logo{
font-weight:1000;font-size:25px;letter-spacing:-1px;
text-shadow:0 0 18px #08aaff;white-space:nowrap
}
.logo span{color:var(--cyan)}
nav{display:flex;gap:5px;flex-wrap:wrap;justify-content:center}
nav a,.lang button{
padding:10px 12px;border-radius:12px;font-weight:750;
font-size:13px;color:#cfe6ff;border:1px solid transparent
}
nav a:hover{background:#0e2b66;border-color:#147dff}
.lang{display:flex;gap:5px}
.lang button{
cursor:pointer;background:#081638;border-color:#174c9b;
transition:.25s
}
.lang button.active{
background:linear-gradient(135deg,#087cff,#11caff);color:white
}
.lang button:active{transform:scale(.9)}

.hero{text-align:center;padding:85px 20px 60px;position:relative;overflow:hidden}
.hero-icon{
font-size:68px;filter:drop-shadow(0 0 18px #00bfff);
animation:float 3s ease-in-out infinite
}
h1{
font-size:clamp(42px,8vw,90px);margin:12px 0;
background:linear-gradient(#fff,#5be0ff 55%,#1785ff);
color:transparent;background-clip:text;font-weight:1000;
letter-spacing:-3px;text-shadow:0 0 35px #007dff44
}
.tagline{font-size:clamp(18px,3vw,28px);color:#c8eaff;font-weight:800}
.buttons,.drive-actions{
display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-top:28px
}
.btn{
display:inline-block;padding:14px 22px;border-radius:14px;font-weight:900;
background:linear-gradient(135deg,#087cff,#10caff);
box-shadow:0 0 24px #008cff55;transition:.2s;border:0;cursor:pointer
}
.btn.secondary{background:#09183c;border:1px solid #147dff;box-shadow:none}
.btn:hover{transform:translateY(-3px);box-shadow:0 0 30px #00cfff88}

.wrap{max-width:1200px;margin:auto;padding:0 20px 65px}
.title{text-align:center;font-size:30px;margin:12px 0 25px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:15px}
.card{
background:linear-gradient(145deg,#0b1d4bdd,#06102cdd);
border:1px solid #087dff88;border-radius:18px;padding:22px;
box-shadow:inset 0 0 20px #087dff0b,0 10px 30px #0002;
transition:.25s
}
.card .ico{font-size:30px}
.card h3{margin:12px 0 8px}
.card p{color:var(--muted);line-height:1.6;margin:0}
.card:hover{border-color:#27e7ff;box-shadow:0 0 25px #00bfff20;transform:translateY(-3px)}

.roles{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}
.role{padding:18px;border-radius:15px;background:#081638;border:1px solid #174b99}
.role b{display:block;margin-bottom:7px;color:#5ee7ff}
.role span{color:#d8e7ff}
.links{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:13px}
.link{display:block;text-align:center;padding:20px 13px;overflow-wrap:anywhere}
.link strong{display:block;margin:9px 0}
.link small{color:var(--muted)}
.dashboard{margin-top:45px}
iframe{width:100%;height:620px;border:1px solid #168cff;border-radius:18px;background:white}
.note{text-align:center;color:var(--muted);font-size:13px;margin-top:10px;line-height:1.6}
footer{text-align:center;padding:28px;color:#91afd9;border-top:1px solid #147aff44}

#loader{
position:fixed;inset:0;z-index:1000;background:#030716;
display:grid;place-items:center;transition:opacity .7s,visibility .7s
}
#loader.hide{opacity:0;visibility:hidden}
.load-inner{text-align:center}
.load-cube{
width:62px;height:62px;margin:0 auto 24px;border:5px solid #24dfff;
border-radius:12px;box-shadow:0 0 25px #00bfff;animation:spinCube 1.15s linear infinite
}
.loadbar{height:5px;width:220px;background:#14244c;border-radius:9px;overflow:hidden;margin:18px auto}
.loadbar i{display:block;height:100%;width:40%;background:linear-gradient(90deg,#087cff,#29efff);animation:load 1.4s ease-in-out infinite}
@keyframes spinCube{to{transform:rotate(360deg)}}
@keyframes load{0%{transform:translateX(-100%)}100%{transform:translateX(350%)}}

#particles{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
.particle{
position:absolute;width:5px;height:5px;background:#20dfff;border-radius:2px;
box-shadow:0 0 12px #00bfff;animation:particleUp linear infinite
}
@keyframes particleUp{
from{transform:translateY(110vh) rotate(0);opacity:0}
10%{opacity:.8}90%{opacity:.7}
to{transform:translateY(-15vh) rotate(720deg);opacity:0}
}
.orbit-cube{
position:absolute;width:70px;height:70px;border:5px solid #18cfff;
border-radius:12px;box-shadow:0 0 25px #008cff;opacity:.5;
animation:spinCube 8s linear infinite
}
.orbit-cube.left{left:8%;top:35%}
.orbit-cube.right{right:9%;top:22%;animation-duration:11s}

.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:13px;margin:24px 0}
.stat{text-align:center;padding:20px;background:#081638;border:1px solid #168cff88;border-radius:16px}
.stat strong{font-size:30px;color:#50eaff;display:block}
.stat span{font-size:13px;color:#a9c3e8}
.level-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
.level{display:flex;align-items:center;gap:13px;padding:15px;background:#081638;border:1px solid #174b99;border-radius:14px}
.level .thumb{
width:52px;height:52px;border-radius:10px;background:linear-gradient(135deg,#0b68ff,#22dfff);
display:grid;place-items:center;font-size:25px;flex-shrink:0
}
.level b{display:block}
.level small{color:#a8bee5}
.level .diff{margin-left:auto;color:#5ee7ff;font-size:12px}
.events{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px}
.event{
position:relative;overflow:hidden;border-radius:17px;padding:22px;
background:linear-gradient(140deg,#10275e,#08102b);border:1px solid #168cff88
}
.event:after{
content:"";position:absolute;width:130px;height:130px;border:2px solid #20dfff33;
border-radius:50%;right:-45px;top:-45px;box-shadow:0 0 35px #008cff22
}
.event .date{color:#5ce8ff;font-size:12px;font-weight:900;letter-spacing:1px}
.event h3{margin:10px 0}
.event p{color:#a9c3e8;line-height:1.5}
.api-box{background:#07112b;border:1px solid #1b70d5;border-radius:16px;padding:18px;overflow:auto}
.api-box code{color:#69eaff;font-family:Consolas,monospace;white-space:pre}
.dashboard-links{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}
.dashlink{
display:block;padding:17px;border:1px solid #1678d688;background:#081638;
border-radius:14px;transition:.2s
