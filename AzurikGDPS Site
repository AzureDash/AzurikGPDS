.future-status:before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
.future-status.soon{background:#00cfff15;color:#4eeaff;border-color:#00cfff44}
.future-status.development{background:#ffb02015;color:#ffc76a;border-color:#ffb02044}
.roadmap-bottom{
